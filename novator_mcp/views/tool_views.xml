<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nmcp_tool_tree" model="ir.ui.view">
        <field name="name">nmcp.tool.tree</field>
        <field name="model">nmcp.tool</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" delete="0" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="description"/>
                <field name="kind" widget="badge" decoration-info="kind == 'read'" decoration-warning="kind == 'write'" decoration-danger="kind == 'delete'"/>
                <field name="call_count"/>
                <field name="name" optional="hide"/>
                <field name="module" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="view_nmcp_tool_search" model="ir.ui.view">
        <field name="name">nmcp.tool.search</field>
        <field name="model">nmcp.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="name"/>
                <filter name="all" string="On and off" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
                <filter name="off" string="Off" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="read" string="Reads data" domain="[('kind', '=', 'read')]"/>
                <filter name="write" string="Changes data" domain="[('kind', 'in', ('write', 'delete'))]"/>
            </search>
        </field>
    </record>
    <record id="action_nmcp_tool" model="ir.actions.act_window">
        <field name="name">AI Tools</field>
        <field name="res_model">nmcp.tool</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tools the AI can use</p>
            <p>Switch a tool off and connected AI apps no longer see it.</p>
        </field>
    </record>
</odoo>
