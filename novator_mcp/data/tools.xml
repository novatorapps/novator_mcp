<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="tool_odoo_whoami" model="nmcp.tool">
            <field name="name">odoo_whoami</field>
            <field name="title">Who am I</field>
            <field name="description">Signed-in user, companies, language, time zone, Odoo version and installed apps.</field>
            <field name="kind">read</field>
            <field name="sequence">10</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_list_models" model="nmcp.tool">
            <field name="name">odoo_list_models</field>
            <field name="title">Find document types</field>
            <field name="description">Search the document types (models) the user can read, by technical name or label. Example: query "invoice" finds account.move.</field>
            <field name="kind">read</field>
            <field name="sequence">20</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_get_fields" model="nmcp.tool">
            <field name="name">odoo_get_fields</field>
            <field name="title">Describe fields</field>
            <field name="description">Fields of a model with label, type, relation, required/readonly and selection values.</field>
            <field name="kind">read</field>
            <field name="sequence">30</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_search_records" model="nmcp.tool">
            <field name="name">odoo_search_records</field>
            <field name="title">Search records</field>
            <field name="description">Search and read records. Returns the total count and the records found.</field>
            <field name="kind">read</field>
            <field name="sequence">40</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_read_records" model="nmcp.tool">
            <field name="name">odoo_read_records</field>
            <field name="title">Read records</field>
            <field name="description">Read records by ID.</field>
            <field name="kind">read</field>
            <field name="sequence">50</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_count_records" model="nmcp.tool">
            <field name="name">odoo_count_records</field>
            <field name="title">Count records</field>
            <field name="description">Count the records that match a domain.</field>
            <field name="kind">read</field>
            <field name="sequence">60</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_group_records" model="nmcp.tool">
            <field name="name">odoo_group_records</field>
            <field name="title">Totals and groups</field>
            <field name="description">Totals grouped by fields, like a pivot table. Measures look like "amount_total:sum"; group by "date_order:month", "user_id", etc.</field>
            <field name="kind">read</field>
            <field name="sequence">70</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_find_by_name" model="nmcp.tool">
            <field name="name">odoo_find_by_name</field>
            <field name="title">Find by name</field>
            <field name="description">Find records by name (customer, product, user...) and return their IDs.</field>
            <field name="kind">read</field>
            <field name="sequence">80</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_create_record" model="nmcp.tool">
            <field name="name">odoo_create_record</field>
            <field name="title">Create a record</field>
            <field name="description">Create a record. Ask the user to confirm first.</field>
            <field name="kind">write</field>
            <field name="sequence">90</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_update_records" model="nmcp.tool">
            <field name="name">odoo_update_records</field>
            <field name="title">Update records</field>
            <field name="description">Change field values on one or more records. Ask the user to confirm first.</field>
            <field name="kind">write</field>
            <field name="sequence">100</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_call_method" model="nmcp.tool">
            <field name="name">odoo_call_method</field>
            <field name="title">Run a button</field>
            <field name="description">Run a business action (a button), e.g. action_confirm on sale.order or action_post on account.move. Ask the user to confirm first.</field>
            <field name="kind">write</field>
            <field name="sequence">110</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_post_note" model="nmcp.tool">
            <field name="name">odoo_post_note</field>
            <field name="title">Log a note</field>
            <field name="description">Log an internal note in the chatter of a record.</field>
            <field name="kind">write</field>
            <field name="sequence">120</field>
            <field name="module">novator_mcp</field>
        </record>
        <record id="tool_odoo_delete_records" model="nmcp.tool">
            <field name="name">odoo_delete_records</field>
            <field name="title">Delete records</field>
            <field name="description">Delete records. Cannot be undone: always ask the user to confirm first.</field>
            <field name="kind">delete</field>
            <field name="sequence">130</field>
            <field name="module">novator_mcp</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
