<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nmcp" model="ir.module.category">
        <field name="name">AI Connector</field>
        <field name="sequence">90</field>
    </record>
    <record id="privilege_nmcp" model="res.groups.privilege">
        <field name="name">AI Connector</field>
        <field name="category_id" ref="module_category_nmcp"/>
    </record>
    <record id="group_nmcp_user" model="res.groups">
        <field name="name">User: can connect AI apps</field>
        <field name="privilege_id" ref="privilege_nmcp"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_nmcp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_nmcp"/>
        <field name="implied_ids" eval="[(4, ref('group_nmcp_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_nmcp_manager'))]"/>
    </record>

</odoo>
