<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nmcp" model="ir.module.category">
        <field name="name">AI Connector</field>
        <field name="sequence">90</field>
    </record>
    <record id="group_nmcp_user" model="res.groups">
        <field name="name">User: can connect AI apps</field>
        <field name="category_id" ref="module_category_nmcp"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>
    <record id="group_nmcp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_nmcp"/>
        <field name="implied_ids" eval="[(4, ref('group_nmcp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_nmcp_manager'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_token_own" model="ir.rule">
            <field name="name">AI connections: own</field>
            <field name="model_id" ref="model_nmcp_token"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_nmcp_user'))]"/>
        </record>
        <record id="rule_token_all" model="ir.rule">
            <field name="name">AI connections: all</field>
            <field name="model_id" ref="model_nmcp_token"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_nmcp_manager'))]"/>
        </record>
        <record id="rule_log_own" model="ir.rule">
            <field name="name">AI activity: own</field>
            <field name="model_id" ref="model_nmcp_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_nmcp_user'))]"/>
        </record>
        <record id="rule_log_all" model="ir.rule">
            <field name="name">AI activity: all</field>
            <field name="model_id" ref="model_nmcp_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_nmcp_manager'))]"/>
        </record>
    </data>
</odoo>
